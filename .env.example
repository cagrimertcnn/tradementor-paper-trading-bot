# TradeMentor Paper Trading Bot example configuration
# Copy this file as .env and update the values before running locally.

WEBHOOK_SECRET=change_me_to_a_random_secret
PAPER_MODE=true

ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

MAX_RISK_PERCENT=0.5
MAX_DAILY_TRADES=3
MAX_OPEN_TRADES=1
MAX_DAILY_LOSS_PERCENT=1.0
MAX_DAILY_STOP_LOSSES=2

SIGNAL_SYMBOL=BTCUSDT
SIGNAL_INTERVAL=5m
SIGNAL_RISK_PERCENT=0.25

SMA_FAST=10
SMA_SLOW=100

RSI_LENGTH=14
ATR_LENGTH=14
ATR_STOP_MULT=1.0

RR_TARGET=1.5

LONG_RSI_MIN=50
LONG_RSI_MAX=62
SHORT_RSI_MIN=32
SHORT_RSI_MAX=48

COOLDOWN_CANDLES=6

LOCAL_WEBHOOK_URL=http://127.0.0.1:8000/webhook
